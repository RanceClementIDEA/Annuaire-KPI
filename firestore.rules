// ════════════════════════════════════════════════════════════════════
//  RÈGLES FIRESTORE — Annuaire KPI (comptes et accès)
//  Projet Firebase : annuaire-kpi
//
//  Copie de référence de ce qui est publié dans
//  Console Firebase → Firestore Database → Règles.
//
//  ⚠️ NE PUBLIER QU'À LA FIN DU BASCULEMENT (voir LISEZ-MOI-COMPTES.md) :
//  tant que tout le monde n'a pas de compte validé, ces règles
//  bloqueraient les personnes encore connectées « par nom ».
//
//  Modèle d'accès :
//    • l'annuaire (kpi_sync) ne s'ouvre qu'aux comptes validés
//      (rôle « membre » ou « admin ») ;
//    • un nouveau compte ne peut que déposer SA demande, sans rôle ;
//    • seul un administrateur donne un rôle et rattache un nom ;
//    • le document principal et ses empreintes ne sont jamais
//      supprimables depuis l'application ;
//    • tout le reste de la base est fermé.
// ════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function ficheExiste() {
      return exists(/databases/$(database)/documents/acces/$(request.auth.uid));
    }
    function roleActuel() {
      return get(/databases/$(database)/documents/acces/$(request.auth.uid)).data.role;
    }
    function aUnRole(roles) {
      return connecte() && ficheExiste() && roleActuel() in roles;
    }
    function estAdmin()  { return aUnRole(['admin']); }
    function estMembre() { return aUnRole(['admin', 'membre']); }

    // Domaines autorisés à DÉPOSER une demande.
    // Même liste que DOMAINES dans js/acces.js : modifier les deux.
    function domaineMaison() {
      return request.auth.token.get('email', '').lower()
               .matches('^[^@]+@(groupe-idea[.]com)$');
    }

    // Les documents de l'annuaire : le principal, ses empreintes, l'horloge,
    // la copie d'essai et les documents du banc de test.
    function documentAnnuaire(doc) {
      return doc.matches('^idea-kpi-(2026|essai)(__[a-z]+)*$');
    }

    match /kpi_sync/{doc} {
      allow get:            if estMembre() && documentAnnuaire(doc);
      allow create, update: if estMembre() && documentAnnuaire(doc);
      // Seuls les documents de TEST se suppriment (banc de test, administrateur)
      allow delete:         if estAdmin() && doc.matches('^idea-kpi-(2026|essai)__(autotest|scenario|masse|conntest|clock)(__[a-z]+)*$');
    }

    // Une fiche par compte : { role, nom, mail, demande }
    match /acces/{uid} {
      allow get:    if connecte() && (request.auth.uid == uid || estAdmin());
      allow list:   if estAdmin();

      // Déposer SA demande : sans rôle, avec une adresse de l'entreprise
      allow create: if connecte()
                    && request.auth.uid == uid
                    && domaineMaison()
                    && request.resource.data.keys().hasOnly(['role', 'nom', 'mail', 'demande'])
                    && request.resource.data.role == ''
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() >= 1
                    && request.resource.data.nom.size() <= 80
                    && request.resource.data.mail is string
                    && request.resource.data.mail.size() <= 120
                    && request.resource.data.demande is string
                    && request.resource.data.demande.size() <= 40;

      // Valider, changer le rôle, rattacher un nom : administrateur seulement
      allow update: if estAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'nom'])
                    && request.resource.data.role in ['', 'admin', 'membre']
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() <= 80;

      allow delete: if estAdmin();
    }

    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
